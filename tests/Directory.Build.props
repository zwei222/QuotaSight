<Project>
  <!--
    Directory.Build.props discovery stops at the nearest file, so the repository-wide defaults in
    the root file have to be imported explicitly before the test-only settings below.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <!--
      The test projects reference the UI project, so NuGet also flows Microsoft.WindowsAppSDK.Base's
      build assets into them. Base fails any non-library project that consumes the Windows App SDK
      without the Runtime package unless that project is self-contained, and it decides that itself
      only while its targets are evaluated: at that point a test project is still OutputType=Library,
      because Microsoft.NET.Test.Sdk switches it to Exe later. So Base's own default never applies
      and the Windows build of both test projects fails with "A framework package dependent Windows
      App SDK app requires a package reference to Microsoft.WindowsAppSDK.Runtime".

      Stating the deployment model here restores the default Base applies to every other non-library
      project: the Windows App SDK payload is copied app-locally instead of depending on a framework
      package that a clean runner does not have. Tests reference the UI project's types and never
      start the app, so nothing else about them changes.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
</Project>
