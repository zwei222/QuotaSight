<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QuotaSight.UI" x:Class="QuotaSight.UI.MainWindow" x:DataType="vm:MainViewModel" Title="QuotaSight" MinWidth="420" MinHeight="520" Width="1100" Height="740">
  <Window.Styles>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="Button.nav:focus"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,14,14"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="38"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="38"/></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource GaugeNormalBrush}"/><Setter Property="Background" Value="{DynamicResource GaugeTrackBrush}"/><Setter Property="MinHeight" Value="12"/></Style>
    <Style Selector="ProgressBar.Attention"><Setter Property="Foreground" Value="{DynamicResource GaugeAttentionBrush}"/></Style>
    <Style Selector="ProgressBar.Danger"><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="ProgressBar.OverLimit"><Setter Property="Foreground" Value="{DynamicResource GaugeOverBrush}"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="0,2"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource BannerBrush}" Padding="18,10" IsVisible="{Binding IsDemo}"><TextBlock Text="{Binding DemoBanner}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></Border>
    <Grid x:Name="ShellGrid" Grid.Row="1" ColumnDefinitions="220,*" RowDefinitions="*">
      <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBrush}" Padding="16,24">
        <DockPanel x:Name="MainNavigation" AutomationProperties.Name="Main navigation">
          <StackPanel x:Name="NavLinks" DockPanel.Dock="Top">
            <TextBlock Text="QS" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="10,0"/>
            <TextBlock Text="QuotaSight" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,10,24"/>
            <Button Classes="nav" Content="{Binding NavDashboardText}" Click="DashboardClick" AutomationProperties.Name="Dashboard"/>
            <Button Classes="nav" Content="{Binding NavHistoryText}" Click="HistoryClick" AutomationProperties.Name="History"/>
            <Button Classes="nav" Content="{Binding NavSettingsText}" Click="SettingsClick" AutomationProperties.Name="Settings"/>
          </StackPanel>
          <Border x:Name="LocalFirstCard" DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="LOCAL-FIRST" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding CopyText.NoSecretsLeave}" Classes="muted" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="ContentScroll" Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentSurface" Margin="28,26,28,40" Spacing="18" Background="{DynamicResource ContentBackgroundBrush}">
          <Grid x:Name="DashboardHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto"><StackPanel x:Name="DashboardHeaderCopy"><TextBlock Text="{Binding HeaderTitle}" Classes="title"/><TextBlock Text="{Binding SubtitleText}" Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="RefreshButton" Grid.Column="1" Content="{Binding RefreshText}" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" AutomationProperties.Name="{Binding CopyText.Refresh}"/></Grid>
          <Border x:Name="QuotaRefreshStatus" Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" IsVisible="{Binding IsQuotaDataBusy}" AutomationProperties.Name="{Binding QuotaStatusText}"><Grid RowDefinitions="Auto,Auto" RowSpacing="6"><ProgressBar x:Name="QuotaRefreshProgressBar" Grid.Row="0" IsIndeterminate="True" AutomationProperties.Name="{Binding QuotaStatusText}"/><TextBlock Grid.Row="1" Text="{Binding QuotaStatusText}" Classes="muted" AutomationProperties.Name="{Binding QuotaStatusText}"/></Grid></Border>
          <Border x:Name="NotificationBanner" Background="{DynamicResource WarningBrush}" CornerRadius="10" Padding="12" IsVisible="{Binding IsNotificationVisible}"><TextBlock Text="{Binding NotificationBannerText}" Foreground="{DynamicResource WarningForegroundBrush}" TextWrapping="Wrap"/></Border>
          <Grid x:Name="DashboardPage" IsVisible="{Binding IsDashboardVisible}"><StackPanel Spacing="18">
            <StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding CopyText.UsageOverview}" FontSize="20" FontWeight="SemiBold"/><Button x:Name="AddProviderButton" Grid.Column="1" Content="{Binding CopyText.AddProvider}" Click="AddProviderClick" AutomationProperties.Name="{Binding CopyText.AddProvider}"/></Grid><Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsProviderFlowOpen}"><ComboBox x:Name="ProviderPicker" ItemsSource="{Binding ProviderChoices}" SelectionChanged="ProviderSelected" IsVisible="{Binding IsProviderFlowOpen}" AutomationProperties.Name="{Binding CopyText.ProviderPicker}"/><Button x:Name="CloseProviderButton" Grid.Column="1" Content="{Binding CopyText.Close}" Click="CloseProviderClick" IsVisible="{Binding IsProviderFlowOpen}" AutomationProperties.Name="{Binding CopyText.Close}"/></Grid></StackPanel>
            <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding HasCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ProviderCardViewModel"><Border Classes="card" Width="320" MaxWidth="440" AutomationProperties.Name="{Binding AccessibleLabel}"><StackPanel Spacing="12"><Grid ColumnDefinitions="Auto,*,Auto"><Border Width="34" Height="34" CornerRadius="10" Background="{Binding Accent}"><TextBlock Text="QS" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="11,0"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Account}" Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextWrapping="Wrap"/></Grid><ItemsControl ItemsSource="{Binding Windows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuotaRowViewModel"><StackPanel Spacing="6"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding WindowName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding Metric}" Classes="muted" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SourceBadge}" Classes="muted" FontSize="10"/></Grid><ProgressBar Classes.Attention="{Binding IsAttention}" Classes.Danger="{Binding IsDanger}" Classes.OverLimit="{Binding IsOverLimit}" Value="{Binding VisualPercent}" Maximum="100" AutomationProperties.Name="{Binding ProgressLabel}"/><TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding ResetText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding FreshnessText}" Classes="muted" FontSize="11" TextWrapping="Wrap" AutomationProperties.Name="{Binding ProgressLabel}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" IsVisible="{Binding HasEmptyState}"><StackPanel><TextBlock Text="{Binding EmptyStateText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18"/><TextBlock Text="{Binding EmptyStateDescription}" Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border x:Name="ManualProviderPanel" Classes="card" IsVisible="{Binding IsManualProviderPanelVisible}"><StackPanel Spacing="10"><TextBlock Text="{Binding CopyText.ConnectManage}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding CopyText.ManualDescription}" Classes="muted" TextWrapping="Wrap"/><Grid x:Name="ManualFormGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8"><TextBlock Text="{Binding CopyText.Provider}"/><TextBlock Grid.Column="1" Text="{Binding CopyText.AccountName}"/><ComboBox x:Name="ManualProviderBox" Grid.Row="1" AutomationProperties.Name="{Binding CopyText.ProviderFieldName}"/><TextBox x:Name="AccountNameBox" Grid.Row="1" Grid.Column="1" Watermark="{Binding CopyText.AccountWatermark}" AutomationProperties.Name="{Binding CopyText.AccountFieldName}"/><TextBlock Grid.Row="2" Text="{Binding CopyText.Window}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CopyText.UsedPercent}"/><ComboBox x:Name="ManualWindowBox" Grid.Row="3" AutomationProperties.Name="{Binding CopyText.WindowFieldName}"/><TextBox x:Name="UsedPercentBox" Grid.Row="3" Grid.Column="1" Watermark="{Binding CopyText.UsedPercentWatermark}" AutomationProperties.Name="{Binding CopyText.UsedPercentFieldName}"/><TextBlock Grid.Row="4" Text="{Binding CopyText.ResetOptional}"/><TextBox x:Name="ResetAtBox" Grid.Row="4" Grid.Column="1" Watermark="{Binding CopyText.ResetAtWatermark}" AutomationProperties.Name="{Binding CopyText.ResetAtFieldName}"/></Grid><WrapPanel x:Name="ManualActions"><Button Content="{Binding CopyText.OpenChatGpt}" Click="OpenChatGptClick" AutomationProperties.Name="Open ChatGPT usage URL"/><Button Content="{Binding CopyText.OpenClaude}" Click="OpenClaudeClick" AutomationProperties.Name="Open Claude usage URL"/><Button Content="{Binding CopyText.AddAccount}" Click="AddManualClick" AutomationProperties.Name="Add manual account"/></WrapPanel><TextBlock x:Name="ManualValidationText" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
            <Border x:Name="CodexCard" Classes="card" IsVisible="{Binding IsCodexProviderPanelVisible}"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="OpenAI Codex" FontSize="18" FontWeight="SemiBold"/><Border Grid.Column="1" Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="8,3"><TextBlock Text="{Binding CopyText.CodexBadge}" FontSize="11" Foreground="{DynamicResource WarningForegroundBrush}"/></Border></Grid><TextBlock Text="{Binding CopyText.CodexDescription}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding CodexStatusText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/><StackPanel IsVisible="{Binding IsCodexPromptVisible}" Spacing="5"><TextBlock Text="{Binding CopyText.CodexCodeLabel}" Classes="muted"/><TextBlock Text="{Binding CodexUserCode}" FontSize="24" FontWeight="Bold" LetterSpacing="2" AutomationProperties.Name="{Binding CopyText.CodexCodeLabel}"/><TextBlock Text="{Binding CodexVerificationUriText}" Classes="muted" TextWrapping="Wrap" AutomationProperties.Name="Codex verification URL"/><TextBlock Text="{Binding CodexExpiresText}" Classes="muted"/></StackPanel><WrapPanel x:Name="CodexActions"><Button x:Name="CodexStartButton" Content="{Binding CopyText.CodexConnect}" Click="CodexStartClick" AutomationProperties.Name="{Binding CopyText.CodexConnect}"/><Button x:Name="CodexOpenButton" Content="{Binding CopyText.CodexOpenBrowser}" Click="CodexOpenClick" IsVisible="{Binding IsCodexPromptVisible}" AutomationProperties.Name="{Binding CopyText.CodexOpenBrowser}"/><Button x:Name="CodexPollButton" Content="{Binding CopyText.CodexConfirm}" Click="CodexPollClick" IsEnabled="{Binding IsCodexPromptVisible}" AutomationProperties.Name="{Binding CopyText.CodexConfirm}"/><Button x:Name="CodexCopyButton" Content="{Binding CopyText.CopyCode}" Click="CodexCopyClick" IsVisible="{Binding IsCodexPromptVisible}" AutomationProperties.Name="{Binding CopyText.CopyCode}"/><Button x:Name="CodexLogoutButton" Content="{Binding CopyText.CodexLogout}" Click="CodexLogoutClick" IsVisible="{Binding IsCodexLogoutVisible}" AutomationProperties.Name="{Binding CopyText.CodexLogout}"/></WrapPanel></StackPanel></Border>
            <Border x:Name="OpenCodePanel" Classes="card" IsVisible="{Binding IsOpenCodeProviderPanelVisible}"><StackPanel Spacing="8"><TextBlock Text="OpenCode Go" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CopyText.OpenCodeDescription}" Classes="muted" TextWrapping="Wrap"/><TextBox x:Name="OpenCodeKeyBox" PasswordChar="•" AutomationProperties.Name="OpenCode Go API key"/><TextBlock Text="{Binding OpenCodeCredentialNotice}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/><Button Content="{Binding CopyText.TestConnection}" Click="OpenCodeTestClick" AutomationProperties.Name="Test OpenCode connection"/></StackPanel></Border>
            <Border x:Name="CopilotPanel" Classes="card" IsVisible="{Binding IsCopilotProviderPanelVisible}"><StackPanel Spacing="8"><TextBlock Text="GitHub Copilot" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CopilotNotice}" Classes="muted" TextWrapping="Wrap"/><TextBlock x:Name="CopilotResultText" Text="{Binding CopilotDeviceResult}" TextWrapping="Wrap"/><WrapPanel x:Name="CopilotActions"><Button Content="{Binding CopyText.StartDevice}" Click="CopilotStartClick" AutomationProperties.Name="Start Copilot device flow"/><Button Content="{Binding CopyText.CopyCode}" Click="CopilotCopyClick"/><Button Content="{Binding CopyText.OpenVerification}" Click="CopilotOpenClick"/><Button Content="{Binding CopyText.Poll}" Click="CopilotPollClick"/><Button Content="{Binding CopyText.ProbeGh}" Click="CopilotProbeClick" AutomationProperties.Name="Probe Copilot gh status"/><Button Content="{Binding CopyText.OpenOfficialUsage}" Click="OpenCopilotClick" AutomationProperties.Name="Open Copilot usage URL"/></WrapPanel></StackPanel></Border>
          </StackPanel></Grid>
          <Grid x:Name="HistoryPage" IsVisible="{Binding IsHistoryVisible}"><StackPanel Spacing="14"><TextBlock Text="{Binding CopyText.History}" Classes="title"/><TextBlock Text="{Binding CopyText.HistoryDescription}" Classes="muted" TextWrapping="Wrap"/><WrapPanel x:Name="HistoryActions"><ComboBox x:Name="HistoryAccountFilter" Width="180" SelectionChanged="HistoryAccountFilterChanged" AutomationProperties.Name="Account filter"/><ComboBox x:Name="HistoryWindowFilter" Width="160" SelectionChanged="HistoryWindowFilterChanged" AutomationProperties.Name="Window filter"/><Button x:Name="HistoryExportButton" Content="{Binding CopyText.ExportCsv}" Click="ExportCsvClick" AutomationProperties.Name="Export history CSV"/><Button Content="{Binding CopyText.ExportJson}" Click="ExportJsonClick" AutomationProperties.Name="Export history JSON"/><Button Content="{Binding CopyText.DeleteAll}" Click="DeleteAllHistoryClick" AutomationProperties.Name="Delete all history"/></WrapPanel><Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="{Binding CopyText.UsageTrend}" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding History.SparklinePoints}" AutomationProperties.Name="History sparkline"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="6" Height="{Binding}" Background="{DynamicResource AccentBrush}" Margin="1,0" VerticalAlignment="Bottom"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><ItemsControl ItemsSource="{Binding History.FilteredEntries}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Provider}" FontWeight="SemiBold"/><TextBlock Text="{Binding Account}" Classes="muted"/><TextBlock Text="{Binding WindowDisplay}" Classes="muted"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding UsedPercent, StringFormat={}{0:0.#}%}"/><Button Content="{Binding $parent[Window].DataContext.HistoryDeleteText}" Click="DeleteHistoryClick" Tag="{Binding Id}" AutomationProperties.Name="Delete history entry"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid>
          <Grid x:Name="SettingsPage" IsVisible="{Binding IsSettingsVisible}"><StackPanel Spacing="14"><TextBlock Text="{Binding CopyText.Settings}" Classes="title"/><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding CopyText.Appearance}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CopyText.Theme}"/><ComboBox x:Name="ThemeBox" SelectionChanged="ThemeChanged" AutomationProperties.Name="Theme"/><TextBlock Text="{Binding CopyText.Language}"/><ComboBox x:Name="LanguageBox" SelectionChanged="LanguageChanged" AutomationProperties.Name="Language"/><TextBlock Text="{Binding CopyText.SupportStatus}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding CopyText.RefreshAlerts}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CopyText.RefreshInterval}"/><NumericUpDown x:Name="RefreshMinutesBox" Minimum="5" Maximum="15" Value="10" ValueChanged="RefreshMinutesChanged" AutomationProperties.Name="Refresh interval"/><CheckBox x:Name="NotificationsBox" Content="{Binding CopyText.EnableNotifications}" IsChecked="True" IsCheckedChanged="NotificationsChanged" AutomationProperties.Name="Enable notifications"/><CheckBox x:Name="ResidentModeBox" Content="{Binding CopyText.ResidentMode}" IsCheckedChanged="ResidentModeChangedClick" AutomationProperties.Name="{Binding CopyText.ResidentMode}"/><TextBlock Text="{Binding CopyText.ResidentModeDescription}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding CopyText.OverallThreshold}"/><NumericUpDown x:Name="ThresholdBox" Minimum="0" Maximum="100" Value="80" ValueChanged="ThresholdChanged" AutomationProperties.Name="Overall threshold"/><TextBlock Text="{Binding CopyText.ProviderOverrides}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding CopyText.Integrations}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CopyText.GithubClientId}"/><TextBox x:Name="GithubClientIdBox" TextChanged="GithubClientIdChanged" AutomationProperties.Name="{Binding CopyText.GithubClientId}"/><TextBlock Text="{Binding CopyText.Autostart}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></Grid>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
