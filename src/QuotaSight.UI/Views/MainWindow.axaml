<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QuotaSight.UI" xmlns:ui="using:QuotaSight.UI.Controls" x:Class="QuotaSight.UI.MainWindow" x:DataType="vm:MainViewModel" Icon="avares://QuotaSight.UI/Assets/quotasight.ico" Title="QuotaSight" MinWidth="420" MinHeight="520" Width="1100" Height="740">
  <Window.Styles>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="LetterSpacing" Value="-0.6"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,3"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontSize" Value="14"/></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BannerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
    <Style Selector="Button.nav:focus"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,14,14"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Border.card TextBlock.muted"><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Border.board"><Setter Property="Background" Value="{DynamicResource SidebarBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/></Style>
    <Style Selector="Border.mono"><Setter Property="Width" Value="23"/><Setter Property="Height" Value="23"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="{DynamicResource BannerBrush}"/></Style>
    <Style Selector="Border.pill"><Setter Property="Background" Value="{DynamicResource BannerBrush}"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="6,2"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
    <Style Selector="Border.pill TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style Selector="Border.pill.neutral TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="Border.chip"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,7"/><Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="Border.chip TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="38"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="38"/></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource GaugeNormalBrush}"/><Setter Property="Background" Value="{DynamicResource GaugeTrackBrush}"/><Setter Property="MinHeight" Value="12"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="Button.icon-action"><Setter Property="Width" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.icon-action PathIcon"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style Selector="Button.icon-action:pointerover"><Setter Property="Background" Value="{DynamicResource BannerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.icon-action:pressed"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.icon-action:pressed PathIcon"><Setter Property="Foreground" Value="{DynamicResource ContentBackgroundBrush}"/></Style>
    <Style Selector="Button.icon-action:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Button.icon-action:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
    <Style Selector="Button.reauth-action"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningForegroundBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,8"/></Style>
    <Style Selector="Button.reauth-action:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <!-- Breakdown rows are rows of the usage card, not separate Fluent panels: the Expander
         chrome is stripped back to the card's own surfaces so the header and the expanded
         content match the surrounding card in both themes. -->
    <Style Selector="Expander"><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="0"/></Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader"><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="0"/></Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Expander /template/ Border#ExpanderContent"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <!-- Restrained danger action: a danger outline on the ordinary button chrome, so a destructive
         row partner is visibly secondary to the primary action without shouting. -->
    <Style Selector="Button.danger-outline"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource GaugeDangerBrush}"/><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="Button.danger-outline:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource GaugeDangerBrush}"/><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="Button.danger-outline:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource GaugeDangerBrush}"/><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="Button.danger-outline:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="ListBox"><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="ListBoxItem:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Border.usage-status"><Setter Property="Background" Value="{DynamicResource BannerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,10"/></Style>
    <Style Selector="Border.usage-status TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="Border.usage-status PathIcon"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="Border.usage-status.configured"><Setter Property="BorderBrush" Value="{DynamicResource GaugeNormalBrush}"/></Style>
    <Style Selector="Border.usage-status.configured TextBlock"><Setter Property="Foreground" Value="{DynamicResource GaugeNormalBrush}"/></Style>
    <Style Selector="Border.usage-status.configured PathIcon"><Setter Property="Foreground" Value="{DynamicResource GaugeNormalBrush}"/></Style>
    <Style Selector="Border.usage-status.session-only"><Setter Property="Background" Value="{DynamicResource WarningBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.session-only TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.session-only PathIcon"><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.store-unavailable"><Setter Property="Background" Value="{DynamicResource WarningBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.store-unavailable TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.store-unavailable PathIcon"><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.invalid"><Setter Property="BorderBrush" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="Border.usage-status.invalid TextBlock"><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="Border.usage-status.invalid PathIcon"><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <!-- The usage page's daily card reuses the same status language as the settings card:
         fixed sentence, icon and a tinted banner per state. delayed/stale warn (the values
         on screen are kept and labelled), error names a first failure with no values. -->
    <Style Selector="Border.usage-status.delayed"><Setter Property="Background" Value="{DynamicResource WarningBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.delayed TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.delayed PathIcon"><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.stale"><Setter Property="Background" Value="{DynamicResource WarningBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.stale TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.stale PathIcon"><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.usage-status.error"><Setter Property="BorderBrush" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="Border.usage-status.error TextBlock"><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="Border.usage-status.error PathIcon"><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="Button.usage-link"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,4"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.usage-link:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.usage-link:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Border.tokscale"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*">
    <Grid x:Name="ShellGrid" Grid.Row="1" ColumnDefinitions="220,*" RowDefinitions="*">
      <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBrush}" Padding="16,24">
        <DockPanel x:Name="MainNavigation" LastChildFill="False" AutomationProperties.Name="Main navigation">
          <StackPanel x:Name="NavLinks" DockPanel.Dock="Top">
            <TextBlock Text="QS" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="10,0"/>
            <TextBlock Text="QuotaSight" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,10,24"/>
            <Button Classes="nav" Content="{Binding NavDashboardText}" Click="DashboardClick" AutomationProperties.Name="Dashboard"/>
            <Button x:Name="UsageNavButton" Classes="nav" Content="{Binding NavUsageText}" Click="UsageClick" AutomationProperties.Name="{Binding NavUsageText}"/>
            <Button Classes="nav" Content="{Binding NavSettingsText}" Click="SettingsClick" AutomationProperties.Name="Settings"/>
          </StackPanel>
          <Border x:Name="LocalFirstCard" DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="12"><StackPanel><TextBlock Text="{Binding CopyText.LocalFirst}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding CopyText.NoSecretsLeave}" Classes="muted" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="ContentScroll" Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentSurface" Margin="32,30,32,44" Spacing="22" Background="{DynamicResource ContentBackgroundBrush}">
          <Grid x:Name="DashboardHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto"><StackPanel x:Name="DashboardHeaderCopy"><TextBlock Text="{Binding HeaderTitle}" Classes="title"/><TextBlock Text="{Binding SubtitleText}" Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap" IsVisible="{Binding IsDashboardVisible}"/></StackPanel><Button x:Name="RefreshButton" Classes="icon-action" Grid.Column="1" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" ToolTip.Tip="{Binding CopyText.Refresh}" AutomationProperties.Name="{Binding CopyText.Refresh}"><PathIcon Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,15.31 15.31,18 12,18C9.24,18 6.95,16.13 6.25,13.6L4.31,14.15C5.25,17.5 8.33,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4Z"/></Button></Grid>
          <Border x:Name="NotificationBanner" Background="{DynamicResource WarningBrush}" CornerRadius="10" Padding="12" IsVisible="{Binding IsNotificationVisible}"><TextBlock Text="{Binding NotificationBannerText}" Foreground="{DynamicResource WarningForegroundBrush}" TextWrapping="Wrap"/></Border>
          <Grid x:Name="DashboardPage" IsVisible="{Binding IsDashboardVisible}"><StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsProviderFlowOpen}"><ui:KeyboardComboBox x:Name="ProviderPicker" ItemsSource="{Binding ProviderChoices}" SelectionChanged="ProviderSelected" IsVisible="{Binding IsProviderFlowOpen}" AutomationProperties.Name="{Binding CopyText.ProviderPicker}"/><Button x:Name="CloseProviderButton" Grid.Column="1" Content="{Binding CopyText.Close}" Click="CloseProviderClick" IsVisible="{Binding IsProviderFlowOpen}" AutomationProperties.Name="{Binding CopyText.Close}"/></Grid>
            <Border x:Name="QuotaContractsSection" Classes="board" IsVisible="{Binding IsQuotaSurfaceVisible}"><StackPanel Spacing="12"><StackPanel Spacing="4"><TextBlock Text="{Binding QuotaTitleText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding QuotaReadStatusText}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsQuotaStatusVisible}"/></StackPanel><ItemsControl ItemsSource="{Binding QuotaCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuotaProviderCard"><Border Classes="tile" MinWidth="300" MaxWidth="440"><StackPanel Spacing="8"><StackPanel Spacing="4"><TextBlock Text="{Binding ProviderText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><Border HorizontalAlignment="Left" Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="6,2" IsVisible="{Binding IsStale}"><TextBlock Text="{Binding FreshnessText}" FontSize="10" Foreground="{DynamicResource WarningForegroundBrush}"/></Border></StackPanel><Grid ColumnDefinitions="86,*" ColumnSpacing="12" MinHeight="86"><Grid Width="86" Height="86"><ui:QuotaRingControl Segments="{Binding RingValues}" UnknownBrush="{DynamicResource TextMutedBrush}" TrackBrush="{DynamicResource GaugeTrackBrush}" ValueBrush="{DynamicResource GaugeNormalBrush}"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasCenter}"><TextBlock Text="{Binding CenterText}" FontSize="{Binding MainCenterFontSize}" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding CenterPeriodText}" Classes="muted" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Grid><ItemsControl Grid.Column="1" ItemsSource="{Binding Windows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuotaCardWindow"><StackPanel Spacing="1" Margin="0,0,0,5"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding WindowText}" FontSize="11"/><TextBlock Text="{Binding RemainingText}" FontSize="15" FontWeight="Bold"/><TextBlock Text="{Binding FreshnessText}" Classes="muted" FontSize="9" IsVisible="{Binding IsStale}"/></StackPanel><TextBlock Text="{Binding ResetText}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          <Border x:Name="TokScaleSection" Classes="board" IsVisible="{Binding IsTokScaleSectionVisible}">
              <StackPanel Spacing="12">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="TokScaleTitle" Text="{Binding TokScaleTitleText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="AddProviderButton" Classes="icon-action" Grid.Column="1" Click="AddProviderClick" ToolTip.Tip="{Binding CopyText.AddProvider}" AutomationProperties.Name="{Binding CopyText.AddProvider}"><PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/></Button>
                  </Grid>
                  <Border Classes="pill" HorizontalAlignment="Left"><TextBlock x:Name="TokScaleBadge" Text="{Binding TokScaleBadgeText}" FontSize="11" TextWrapping="Wrap"/></Border>
                </StackPanel>
                <TextBlock x:Name="TokScaleStatus" Classes="muted" Text="{Binding TokScaleStateText}" IsVisible="{Binding IsTokScaleStatusVisible}" TextWrapping="Wrap" AutomationProperties.Name="{Binding TokScaleStateText}"/>
                <ProgressBar x:Name="TokScaleLoadingBar" IsIndeterminate="True" IsVisible="{Binding IsTokScaleLoading}" MinHeight="8"/>
                <StackPanel x:Name="TokScaleEmptyState" Spacing="6" IsVisible="{Binding IsTokScaleEmptyStateVisible}">
                  <TextBlock x:Name="TokScaleEmptyTitle" Text="{Binding TokScaleEmptyTitleText}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" AutomationProperties.Name="{Binding TokScaleEmptyTitleText}"/>
                  <TextBlock x:Name="TokScaleEmptyBody" Classes="muted" Text="{Binding TokScaleEmptyBodyText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding TokScaleEmptyBodyText}"/>
                  <Button x:Name="TokScaleOpenSettingsButton" Classes="usage-link" Content="{Binding TokScaleOpenSettingsText}" Click="UsageOpenSettingsClick" HorizontalAlignment="Left" IsVisible="{Binding IsTokScaleUnconfigured}" AutomationProperties.Name="{Binding TokScaleOpenSettingsText}"/>
                </StackPanel>
                <TextBlock x:Name="TokScaleFreshness" Classes="muted" Text="{Binding TokScaleFreshnessText}" IsVisible="{Binding IsTokScaleFreshnessVisible}" TextWrapping="Wrap" AutomationProperties.Name="{Binding TokScaleFreshnessText}"/>
                <ItemsControl x:Name="TokScaleCards" ItemsSource="{Binding TokScaleCards}" AutomationProperties.Name="{Binding TokScaleTitleText}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TokScaleUsageCard">
                      <Border Classes="tokscale" MinWidth="170" MaxWidth="260" AutomationProperties.Name="{Binding SummaryText}">
                        <!-- Fixed row heights keep every card the same height in a WrapPanel
                             row, whatever the name's line count; the name wraps to at most
                             two lines and is never cut off with an ellipsis. -->
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" LineHeight="17" Height="34" MaxLines="2" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.Name="{Binding DisplayName}"/>
                          <TextBlock Classes="muted" FontSize="12" LineHeight="16" Height="32" MaxLines="2" TextWrapping="Wrap" TextTrimming="None" Text="{Binding SummaryText}" AutomationProperties.Name="{Binding SummaryText}"/>
                          <Grid Height="26">
                            <!-- Right padding keeps the notice clear of the card's inner
                                 edge: the card otherwise sizes itself exactly to this
                                 label's natural width and the line ends flush against the
                                 border, which reads as clipped on screen. -->
                            <TextBlock Classes="muted" FontSize="10" LineHeight="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="None" Padding="0,0,8,0" Text="{Binding MultiProviderText}" IsVisible="{Binding IsMultiProvider}" VerticalAlignment="Top" AutomationProperties.Name="{Binding MultiProviderText}"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border x:Name="TokScalePanel" Classes="card" IsVisible="{Binding IsTokScaleProviderPanelVisible}"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="TokScaleFlowTitle" Text="{Binding TokScaleFlowTitleText}" FontSize="18" FontWeight="SemiBold"/><Border Grid.Column="1" Classes="pill" VerticalAlignment="Center"><TextBlock Text="{Binding CopyText.TokScalePanelTitle}" FontSize="11"/></Border></Grid><TextBlock Text="{Binding TokScaleFlowDescriptionText}" Classes="muted" TextWrapping="Wrap"/><TextBlock x:Name="TokScaleFlowStatus" Text="{Binding TokScaleFlowStatusText}" Classes="muted" TextWrapping="Wrap" AutomationProperties.Name="{Binding TokScaleFlowStatusText}"/><WrapPanel x:Name="TokScaleActions"><Button x:Name="TokScaleAddButton" Content="{Binding CopyText.TokScalePanelAdd}" Click="TokScaleAddClick" IsVisible="{Binding !IsTokScaleProviderTracked}" AutomationProperties.Name="{Binding CopyText.TokScalePanelAdd}"/><Button x:Name="TokScaleRemoveButton" Content="{Binding CopyText.TokScalePanelRemove}" Click="TokScaleRemoveClick" IsVisible="{Binding IsTokScaleProviderTracked}" AutomationProperties.Name="{Binding CopyText.TokScalePanelRemove}"/></WrapPanel></StackPanel></Border>
          </StackPanel></Grid>
          <Grid x:Name="UsagePage" IsVisible="{Binding IsUsageVisible}" AutomationProperties.Name="{Binding NavUsageText}"><StackPanel Spacing="18"><Border Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel Spacing="12"><TextBlock Text="{Binding NavUsageText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="UsageTimeZone" Text="{Binding UsageRangeText}" Classes="muted" IsVisible="{Binding IsUsageRangeVisible}"/><Button x:Name="UsageRefreshButton" Content="{Binding RefreshText}" Click="UsageRefreshClick" IsEnabled="{Binding CanRefreshUsage}" HorizontalAlignment="Left"/><Border x:Name="UsageDailyCard" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14"><StackPanel Spacing="8"><TextBlock x:Name="UsageStatus" Text="{Binding UsageStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="{Binding UsageStatusText}"/><ProgressBar x:Name="UsageLoadingBar" IsIndeterminate="True" IsVisible="{Binding IsUsageLoading}"/><Grid x:Name="UsageTotalRow" ColumnDefinitions="*,Auto"><TextBlock x:Name="UsageTotalLabel" Text="{Binding CopyText.UsageTotalTokens}" FontWeight="SemiBold" IsVisible="{Binding IsUsageTotalVisible}"/><TextBlock x:Name="UsageTotal" Grid.Column="1" Text="{Binding UsageTotalText}" IsVisible="{Binding IsUsageTotalVisible}" FontWeight="Bold" FontSize="20"/></Grid><TextBlock x:Name="UsageFreshnessLine" Classes="muted" Text="{Binding UsageFreshnessText}" IsVisible="{Binding IsUsageFreshnessVisible}" TextWrapping="Wrap" AutomationProperties.Name="{Binding UsageFreshnessText}"/><Border x:Name="UsageFailurePanel" Classes="usage-status" IsVisible="False" AutomationProperties.Name="{Binding UsageFailureText}"><Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="8"><Border Height="22" VerticalAlignment="Top"><Grid><PathIcon x:Name="UsageFailureStaleIcon" Width="16" Height="16" Margin="0,0,8,0" Data="M13 14H11V9H13M13 18H11V16H13M23 21L12 2L1 21H23M13 16H11V14H13V16Z" IsVisible="{Binding IsUsageStale}" HorizontalAlignment="Left" VerticalAlignment="Center"/><PathIcon x:Name="UsageFailureErrorIcon" Width="16" Height="16" Margin="0,0,8,0" Data="M13,14H11V9H13M13,18H11V16H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" IsVisible="{Binding !IsUsageStale}" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid></Border><TextBlock x:Name="UsageFailureTextBlock" Grid.Column="1" Text="{Binding UsageFailureText}" LineHeight="22" TextWrapping="Wrap" AutomationProperties.Name="{Binding UsageFailureText}"/><WrapPanel x:Name="UsageFailureActions" Grid.Column="1" Grid.Row="1" ItemSpacing="8" LineSpacing="8"><Button x:Name="UsageRetryButton" Classes="reauth-action" Content="{Binding CopyText.UsageRetry}" Click="UsageRetryClick" AutomationProperties.Name="{Binding CopyText.UsageRetry}"/><Button x:Name="UsageOpenSettingsButton" Classes="usage-link" Content="{Binding CopyText.UsageOpenSettings}" Click="UsageOpenSettingsClick" AutomationProperties.Name="{Binding CopyText.UsageOpenSettings}"/></WrapPanel></Grid></Border><Border x:Name="UsageDelayedBanner" Classes="usage-status delayed" IsVisible="{Binding IsUsageDelayed}" AutomationProperties.Name="{Binding UsageDelayedText}"><Grid ColumnDefinitions="Auto,*"><Border Height="22" VerticalAlignment="Top"><Grid><PathIcon x:Name="UsageDelayedIcon" Width="16" Height="16" Margin="0,0,8,0" Data="M13 14H11V9H13M13 18H11V16H13M23 21L12 2L1 21H23M13 16H11V14H13V16Z" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid></Border><TextBlock x:Name="UsageDelayedTextBlock" Grid.Column="1" Text="{Binding UsageDelayedText}" LineHeight="22" TextWrapping="Wrap" AutomationProperties.Name="{Binding UsageDelayedText}"/></Grid></Border><ItemsControl x:Name="UsageRows" ItemsSource="{Binding UsageRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:UsageDay"><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8"><Grid ColumnDefinitions="*,*,Auto"><TextBlock Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}"/><TextBlock Grid.Column="1" Text="{Binding CollectorId}" Classes="muted" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding TotalTokens, StringFormat='{}{0:N0} tokens'}" FontWeight="SemiBold"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></Border>
            <Border x:Name="UsageBreakdownCard" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14">
              <StackPanel Spacing="8">
                <TextBlock x:Name="UsageBreakdownTitle" Text="{Binding CopyText.UsageBreakdownTitle}" FontWeight="SemiBold"/>
                <TextBlock x:Name="UsageBreakdownStatus" Text="{Binding UsageBreakdownStateText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="{Binding UsageBreakdownStateText}"/>
                <ProgressBar x:Name="UsageBreakdownLoadingBar" IsIndeterminate="True" IsVisible="{Binding IsUsageBreakdownLoading}" MinHeight="8"/>
                <ui:KeyboardComboBox x:Name="BreakdownDimensionBox" ItemsSource="{Binding BreakdownDimensionChoices}" IsEnabled="{Binding CanSwitchBreakdownDimension}" SelectionChanged="BreakdownDimensionChanged" HorizontalAlignment="Left" MinWidth="150" AutomationProperties.Name="{Binding CopyText.UsageBreakdownDimensionSelector}"/>
                <TextBlock x:Name="UsageBreakdownNote" Classes="muted" Text="{Binding BreakdownNoteText}" IsVisible="{Binding IsBreakdownNoteVisible}" TextWrapping="Wrap" AutomationProperties.Name="{Binding BreakdownNoteText}"/>
                <Border x:Name="UsageBreakdownFailurePanel" Classes="usage-status" IsVisible="False" AutomationProperties.Name="{Binding BreakdownFailureText}">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Border Height="22" VerticalAlignment="Top">
                      <Grid>
                        <PathIcon x:Name="UsageBreakdownStaleIcon" Width="16" Height="16" Margin="0,0,8,0" Data="M13 14H11V9H13M13 18H11V16H13M23 21L12 2L1 21H23M13 16H11V14H13V16Z" IsVisible="{Binding IsBreakdownStale}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <PathIcon x:Name="UsageBreakdownErrorIcon" Width="16" Height="16" Margin="0,0,8,0" Data="M13,14H11V9H13M13,18H11V16H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" IsVisible="{Binding !IsBreakdownStale}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <TextBlock x:Name="UsageBreakdownFailureTextBlock" Grid.Column="1" Text="{Binding BreakdownFailureText}" LineHeight="22" TextWrapping="Wrap" AutomationProperties.Name="{Binding BreakdownFailureText}"/>
                    <WrapPanel x:Name="UsageBreakdownFailureActions" Grid.Column="1" Grid.Row="1" ItemSpacing="8" LineSpacing="8">
                      <Button x:Name="UsageBreakdownRetryButton" Classes="reauth-action" Content="{Binding CopyText.UsageRetry}" Click="UsageRetryClick" AutomationProperties.Name="{Binding CopyText.UsageRetry}"/>
                      <Button x:Name="UsageBreakdownOpenSettingsButton" Classes="usage-link" Content="{Binding CopyText.UsageOpenSettings}" Click="UsageOpenSettingsClick" AutomationProperties.Name="{Binding CopyText.UsageOpenSettings}"/>
                    </WrapPanel>
                  </Grid>
                </Border>
                <Border x:Name="UsageBreakdownUnclassifiedNote" Classes="pill neutral" IsVisible="{Binding IsBreakdownUnclassifiedVisible}"><TextBlock Text="{Binding BreakdownUnclassifiedText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding BreakdownUnclassifiedText}"/></Border>
                <TextBlock x:Name="UsageBreakdownPartialNote" Classes="muted" Text="{Binding BreakdownPartialText}" IsVisible="{Binding IsBreakdownPartialVisible}" TextWrapping="Wrap" AutomationProperties.Name="{Binding BreakdownPartialText}"/>
                <Border x:Name="UsageBreakdownOverAttributionNote" Classes="usage-status delayed" IsVisible="{Binding IsBreakdownOverAttributedVisible}"><TextBlock Text="{Binding BreakdownOverAttributionText}" LineHeight="22" TextWrapping="Wrap" AutomationProperties.Name="{Binding BreakdownOverAttributionText}"/></Border>
                <ItemsControl x:Name="BreakdownRows" ItemsSource="{Binding BreakdownRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BreakdownGroup">
                      <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                        <Expander.Header>
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ShareText, StringFormat='{}{0}%'}" Classes="muted" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat='{}{0:N0}'}" Margin="12,0,0,0"/>
                          </Grid>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding PartRows}" Margin="16,0,0,8">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BreakdownPartRow">
                              <StackPanel Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                </Grid>
                                <WrapPanel ItemSpacing="10" LineSpacing="2">
                                  <TextBlock Text="{Binding InputText}" Classes="muted"/>
                                  <TextBlock Text="{Binding OutputText}" Classes="muted"/>
                                  <TextBlock Text="{Binding CacheReadText}" Classes="muted"/>
                                  <TextBlock Text="{Binding CacheWriteText}" Classes="muted"/>
                                  <TextBlock Text="{Binding ReasoningText}" Classes="muted"/>
                                </WrapPanel>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border></StackPanel></Grid>
          <Grid x:Name="SettingsPage" IsVisible="{Binding IsSettingsVisible}"><StackPanel Spacing="14"><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding CopyText.Appearance}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CopyText.Theme}"/><ui:KeyboardComboBox x:Name="ThemeBox" SelectionChanged="ThemeChanged" AutomationProperties.Name="Theme"/><TextBlock Text="{Binding CopyText.Language}"/><ui:KeyboardComboBox x:Name="LanguageBox" SelectionChanged="LanguageChanged" AutomationProperties.Name="Language"/><TextBlock Text="{Binding CopyText.SupportStatus}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding CopyText.RefreshAlerts}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CopyText.RefreshInterval}"/><NumericUpDown x:Name="RefreshMinutesBox" Minimum="5" Maximum="15" Value="10" ValueChanged="RefreshMinutesChanged" AutomationProperties.Name="Refresh interval"/><CheckBox x:Name="ResidentModeBox" Content="{Binding CopyText.ResidentMode}" IsCheckedChanged="ResidentModeChangedClick" AutomationProperties.Name="{Binding CopyText.ResidentMode}"/><TextBlock Text="{Binding CopyText.ResidentModeDescription}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <Border x:Name="UsageConnectionCard" Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="{Binding CopyText.UsageConnectionTitle}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding CopyText.UsageConnectionDescription}" Classes="muted" TextWrapping="Wrap"/>
              <Border x:Name="UsageConnectionStatusPanel" Classes="usage-status">
                <!-- A horizontal StackPanel hands its children unbounded width, which lets the
                     status sentence run past the panel edge instead of wrapping. Fixed icon
                     column plus a star text column keeps the wrap constrained to the card. -->
                <Grid x:Name="UsageStatusBannerGrid" ColumnDefinitions="Auto,*">
                  <!-- Same first-line standard as the usage page banners: the icon lives in a
                       22px cell that matches the text's fixed 22px line box, so it centers on
                       the first line whatever font lays the sentence out (CI's DejaVu Sans
                       draws a 16.3px line; paragraph-centering would drift into the middle). -->
                  <Border Height="22" VerticalAlignment="Top">
                    <Grid>
                      <PathIcon x:Name="UsageStatusConfiguredIcon" Width="16" Height="16" Margin="0,0,8,0" Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" IsVisible="{Binding IsUsageConnectionConfigured}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                      <PathIcon x:Name="UsageStatusSessionIcon" Width="16" Height="16" Margin="0,0,8,0" Data="M13 14H11V9H13M13 18H11V16H13M23 21L12 2L1 21H23M13 16H11V14H13V16Z" IsVisible="{Binding IsUsageConnectionSessionOnly}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                      <PathIcon x:Name="UsageStatusStoreIcon" Width="16" Height="16" Margin="0,0,8,0" Data="M13 14H11V9H13M13 18H11V16H13M23 21L12 2L1 21H23M13 16H11V14H13V16Z" IsVisible="{Binding IsUsageConnectionStoreUnavailable}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                      <PathIcon x:Name="UsageStatusInvalidIcon" Width="16" Height="16" Margin="0,0,8,0" Data="M13,14H11V9H13M13,18H11V16H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" IsVisible="{Binding IsUsageConnectionInvalid}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <TextBlock x:Name="UsageConnectionStatusText" Grid.Column="1" Text="{Binding UsageConnectionStatusText}" LineHeight="22" TextWrapping="Wrap" AutomationProperties.Name="{Binding UsageConnectionStatusText}"/>
                </Grid>
              </Border>
              <!-- Pills wrap onto further rows instead of spilling past the card border; each
                     pill's own text wraps too, so a single long pill can never overflow. -->
              <WrapPanel x:Name="UsageCredentialPills" ItemSpacing="8" LineSpacing="8">
                <Border Classes="pill"><TextBlock Text="{Binding UsageCredentialStatusText}" TextWrapping="Wrap"/></Border>
                <Border Classes="pill warn" IsVisible="{Binding IsUsageConnectionSessionOnly}"><TextBlock Text="{Binding CopyText.UsageSessionOnlyBadge}" TextWrapping="Wrap"/></Border>
                <Border Classes="pill warn" IsVisible="{Binding IsUsageConnectionStoreUnavailable}"><TextBlock Text="{Binding CopyText.UsageStoreUnavailableBadge}" TextWrapping="Wrap"/></Border>
              </WrapPanel>
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding CopyText.UsageEndpointLabel}"/>
                <TextBox x:Name="UsageEndpointBox" PlaceholderText="https://usage.example.test" MaxLength="256" AutomationProperties.Name="{Binding CopyText.UsageEndpointLabel}"/>
                <TextBlock Text="{Binding CopyText.UsageEndpointHint}" Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding CopyText.UsageClientIdLabel}"/>
                <TextBox x:Name="UsageClientIdBox" AutomationProperties.Name="{Binding CopyText.UsageClientIdLabel}"/>
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding CopyText.UsageClientSecretLabel}" TextWrapping="Wrap"/>
                <TextBox x:Name="UsageClientSecretBox" PasswordChar="•" KeyDown="UsageSecretKeyDown" AutomationProperties.Name="{Binding CopyText.UsageClientSecretLabel}"><TextBox.ContextMenu><ContextMenu/></TextBox.ContextMenu></TextBox>
              </StackPanel>
              <TextBlock x:Name="UsageConnectionValidationText" Foreground="{DynamicResource GaugeDangerBrush}" TextWrapping="Wrap" IsVisible="{Binding HasUsageConnectionError}" AutomationProperties.Name="Usage connection validation"/>
              <WrapPanel x:Name="UsageConnectionActions">
                <Button x:Name="UsageConnectionSaveButton" Margin="0,2,12,2" Content="{Binding CopyText.UsageConnectionSave}" Click="UsageConnectionSaveClick" AutomationProperties.Name="{Binding CopyText.UsageConnectionSave}"/>
                <Button x:Name="UsageConnectionRemoveButton" Classes="danger-outline" Content="{Binding CopyText.UsageConnectionRemove}" Click="UsageConnectionRemoveClick" IsEnabled="{Binding !IsUsageConnectionUnconfigured}" AutomationProperties.Name="{Binding CopyText.UsageConnectionRemove}"/>
              </WrapPanel>
              <StackPanel x:Name="UsageRemoveConfirmPanel" IsVisible="False" Spacing="8">
                <TextBlock Text="{Binding CopyText.UsageConnectionRemoveConfirm}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="UsageConnectionConfirmRemoveButton" Classes="reauth-action" Content="{Binding CopyText.UsageConnectionConfirmRemove}" Click="UsageConnectionConfirmRemoveClick" AutomationProperties.Name="{Binding CopyText.UsageConnectionConfirmRemove}"/>
                  <Button x:Name="UsageConnectionCancelRemoveButton" Content="{Binding CopyText.UsageConnectionCancelRemove}" Click="UsageConnectionCancelRemoveClick" AutomationProperties.Name="{Binding CopyText.UsageConnectionCancelRemove}"/>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="UsageConnectionBusyPanel" IsVisible="False" Spacing="6">
                <ProgressBar x:Name="UsageConnectionProgressBar" IsIndeterminate="True" MinHeight="8" AutomationProperties.Name="{Binding CopyText.UsageConnectionSaving}"/>
                <TextBlock x:Name="UsageConnectionBusyText" Text="{Binding CopyText.UsageConnectionSaving}" Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border></StackPanel></Grid>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
