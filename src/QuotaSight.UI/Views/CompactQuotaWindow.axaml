<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QuotaSight.UI" xmlns:ui="using:QuotaSight.UI.Controls" x:Class="QuotaSight.UI.CompactQuotaWindow" x:DataType="vm:MainViewModel" Icon="avares://QuotaSight.UI/Assets/quotasight.ico" Title="QuotaSight" Width="410" MinWidth="380" MaxWidth="430" Height="620" MaxHeight="700" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="Border.tokscale"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="Button.icon-action"><Setter Property="Width" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.icon-action PathIcon"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style Selector="Button.icon-action:pointerover"><Setter Property="Background" Value="{DynamicResource BannerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.icon-action:pressed"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.icon-action:pressed PathIcon"><Setter Property="Foreground" Value="{DynamicResource ContentBackgroundBrush}"/></Style>
    <Style Selector="Button.icon-action:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Button.icon-action:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource ContentBackgroundBrush}">
    <Border Grid.Row="0" Padding="18,16,18,8"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding CopyText.CompactTitle}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding CopyText.CompactSubtitle}" Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="CompactRefreshButton" Classes="icon-action" Grid.Column="1" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" ToolTip.Tip="{Binding CopyText.Refresh}" AutomationProperties.Name="{Binding CopyText.Refresh}"><PathIcon Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,15.31 15.31,18 12,18C9.24,18 6.95,16.13 6.25,13.6L4.31,14.15C5.25,17.5 8.33,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4Z"/></Button></Grid></Border>
    <Border Grid.Row="1" Margin="18,4,18,8" Padding="10" Background="{DynamicResource BannerBrush}" CornerRadius="9" IsVisible="{Binding IsTokScaleLoading}" AutomationProperties.Name="{Binding TokScaleStateText}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><ProgressBar x:Name="CompactRefreshProgress" IsIndeterminate="True" Width="72" VerticalAlignment="Center" AutomationProperties.Name="{Binding TokScaleStateText}"/><TextBlock Text="{Binding TokScaleStateText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
    <Border x:Name="CompactNotificationBanner" Grid.Row="2" Margin="18,0,18,8" Padding="10" Background="{DynamicResource WarningBrush}" CornerRadius="9" IsVisible="{Binding IsNotificationVisible}" AutomationProperties.Name="{Binding NotificationBannerText}"><TextBlock Text="{Binding NotificationBannerText}" Foreground="{DynamicResource WarningForegroundBrush}" TextWrapping="Wrap"/></Border>
    <ScrollViewer Grid.Row="3" Margin="18,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border x:Name="CompactQuotaContracts" Classes="tokscale" IsVisible="{Binding IsQuotaSurfaceVisible}"><StackPanel Spacing="6"><TextBlock Text="{Binding QuotaTitleText}" FontWeight="SemiBold"/><TextBlock Text="{Binding QuotaReadStatusText}" Classes="muted" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding IsQuotaStatusVisible}"/><ItemsControl ItemsSource="{Binding QuotaCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuotaProviderCard"><Border Classes="tokscale" Margin="0,0,0,7"><StackPanel Spacing="5"><StackPanel Spacing="3"><TextBlock Text="{Binding ProviderText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><Border HorizontalAlignment="Left" Background="{DynamicResource WarningBrush}" CornerRadius="7" Padding="5,1" IsVisible="{Binding IsStale}"><TextBlock Text="{Binding FreshnessText}" FontSize="9" Foreground="{DynamicResource WarningForegroundBrush}"/></Border></StackPanel><Grid ColumnDefinitions="72,*" ColumnSpacing="10" MinHeight="72"><Grid Width="72" Height="72"><ui:QuotaRingControl Segments="{Binding RingValues}" UnknownBrush="{DynamicResource TextMutedBrush}" TrackBrush="{DynamicResource GaugeTrackBrush}" ValueBrush="{DynamicResource GaugeNormalBrush}" InnerBrush="{DynamicResource AccentBrush}"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasCenter}"><TextBlock Text="{Binding CenterText}" FontSize="{Binding CompactCenterFontSize}" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding CenterPeriodText}" Classes="muted" FontSize="8" HorizontalAlignment="Center"/></StackPanel></Grid><ItemsControl Grid.Column="1" ItemsSource="{Binding Windows}" VerticalAlignment="Center"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuotaCardWindow"><StackPanel Spacing="1" Margin="0,0,0,4"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding WindowText}" FontSize="10"/><TextBlock Text="{Binding RemainingText}" FontSize="13" FontWeight="Bold"/><TextBlock Text="{Binding FreshnessText}" Classes="muted" FontSize="8" IsVisible="{Binding IsStale}"/></StackPanel><TextBlock Text="{Binding ResetText}" Classes="muted" FontSize="9" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Border x:Name="CompactTokScaleEmptyState" Classes="tokscale" IsVisible="{Binding IsTokScaleEmptyStateVisible}" AutomationProperties.Name="{Binding TokScaleEmptyTitleText}"><StackPanel Spacing="6"><TextBlock x:Name="CompactTokScaleEmptyTitle" Text="{Binding TokScaleEmptyTitleText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="{Binding TokScaleEmptyTitleText}"/><TextBlock x:Name="CompactTokScaleEmptyBody" Text="{Binding TokScaleEmptyBodyText}" Classes="muted" TextWrapping="Wrap" AutomationProperties.Name="{Binding TokScaleEmptyBodyText}"/></StackPanel></Border>
        <TextBlock x:Name="CompactTokScaleStatus" Classes="muted" Text="{Binding TokScaleStateText}" IsVisible="{Binding IsTokScaleStatusVisible}" Margin="2,4" TextWrapping="Wrap" AutomationProperties.Name="{Binding TokScaleStateText}"/>
        <ItemsControl x:Name="CompactTokScaleCards" ItemsSource="{Binding TokScaleCards}" IsVisible="{Binding IsTokScaleCardsVisible}" AutomationProperties.Name="{Binding TokScaleTitleText}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TokScaleUsageCard">
              <Border Classes="tokscale" Margin="0,0,0,7">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="None" AutomationProperties.Name="{Binding DisplayName}"/>
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding SummaryText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding SummaryText}"/>
                  <TextBlock Classes="muted" FontSize="10" Text="{Binding MultiProviderText}" IsVisible="{Binding IsMultiProvider}" TextWrapping="Wrap" AutomationProperties.Name="{Binding MultiProviderText}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="4" Padding="18,8,18,16"><Button x:Name="CompactOpenFullButton" Content="{Binding CopyText.OpenFullWindow}" Click="OpenFullClick" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding CopyText.OpenFullWindow}"/></Border>
  </Grid>
</Window>
