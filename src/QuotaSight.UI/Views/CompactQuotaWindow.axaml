<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QuotaSight.UI" x:Class="QuotaSight.UI.CompactQuotaWindow" x:DataType="vm:MainViewModel" Icon="avares://QuotaSight.UI/Assets/quotasight.ico" Title="QuotaSight" Width="410" MinWidth="380" MaxWidth="430" Height="620" MaxHeight="700" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="Border.compact-card"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style Selector="ProgressBar"><Setter Property="MinHeight" Value="10"/><Setter Property="Background" Value="{DynamicResource GaugeTrackBrush}"/><Setter Property="Foreground" Value="{DynamicResource GaugeNormalBrush}"/></Style>
    <Style Selector="ProgressBar.Attention"><Setter Property="Foreground" Value="{DynamicResource GaugeAttentionBrush}"/></Style>
    <Style Selector="ProgressBar.Danger"><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="ProgressBar.OverLimit"><Setter Property="Foreground" Value="{DynamicResource GaugeOverBrush}"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="Button.icon-action"><Setter Property="Width" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.icon-action PathIcon"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style Selector="Button.icon-action:pointerover"><Setter Property="Background" Value="{DynamicResource BannerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.icon-action:pressed"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.icon-action:pressed PathIcon"><Setter Property="Foreground" Value="{DynamicResource ContentBackgroundBrush}"/></Style>
    <Style Selector="Button.icon-action:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Button.icon-action:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource ContentBackgroundBrush}">
    <Border Grid.Row="0" Padding="18,16,18,8"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding CopyText.CompactTitle}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding CopyText.CompactSubtitle}" Classes="muted" Margin="0,3,0,0"/></StackPanel><Button x:Name="CompactRefreshButton" Classes="icon-action" Grid.Column="1" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" ToolTip.Tip="{Binding CopyText.Refresh}" AutomationProperties.Name="{Binding CopyText.Refresh}"><PathIcon Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,15.31 15.31,18 12,18C9.24,18 6.95,16.13 6.25,13.6L4.31,14.15C5.25,17.5 8.33,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4Z"/></Button></Grid></Border>
    <Border Grid.Row="1" Margin="18,4,18,8" Padding="10" Background="{DynamicResource BannerBrush}" CornerRadius="9" IsVisible="{Binding IsQuotaDataBusy}" AutomationProperties.Name="{Binding QuotaStatusText}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><ProgressBar x:Name="CompactRefreshProgress" IsIndeterminate="True" Width="72" VerticalAlignment="Center" AutomationProperties.Name="{Binding QuotaStatusText}"/><TextBlock Text="{Binding QuotaStatusText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
    <Border x:Name="CompactNotificationBanner" Grid.Row="2" Margin="18,0,18,8" Padding="10" Background="{DynamicResource WarningBrush}" CornerRadius="9" IsVisible="{Binding IsNotificationVisible}" AutomationProperties.Name="{Binding NotificationBannerText}"><TextBlock Text="{Binding NotificationBannerText}" Foreground="{DynamicResource WarningForegroundBrush}" TextWrapping="Wrap"/></Border>
    <ScrollViewer Grid.Row="3" Margin="18,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border x:Name="CompactEmptyState" Classes="compact-card" IsVisible="{Binding HasEmptyState}" AutomationProperties.Name="{Binding EmptyStateText}"><StackPanel Spacing="6"><TextBlock x:Name="CompactEmptyStateText" Text="{Binding EmptyStateText}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CompactEmptyStateDescription" Text="{Binding EmptyStateDescription}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
        <ItemsControl x:Name="CompactProviderCards" ItemsSource="{Binding Cards}" IsVisible="{Binding HasCards}" AutomationProperties.Name="{Binding CopyText.CompactProviders}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ProviderCardViewModel"><Border Classes="compact-card" AutomationProperties.Name="{Binding AccessibleLabel}"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Account}" Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/></Grid><ItemsControl ItemsSource="{Binding Windows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuotaRowViewModel"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding WindowName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SourceBadge}" Classes="muted" FontSize="10"/></Grid><ProgressBar Value="{Binding VisualPercent}" Maximum="100" IsVisible="{Binding IsGaugeVisible}" Classes.Attention="{Binding IsAttention}" Classes.Danger="{Binding IsDanger}" Classes.OverLimit="{Binding IsOverLimit}" AutomationProperties.Name="{Binding ProgressLabel}"/><TextBlock Text="{Binding PercentText}" IsVisible="{Binding IsGaugeVisible}" TextWrapping="Wrap"/><StackPanel IsVisible="{Binding IsQuantityVisible}" Spacing="2"><TextBlock Text="{Binding QuantityGrossText}" FontWeight="SemiBold"/><TextBlock Text="{Binding QuantityDiscountText}" Classes="muted"/><TextBlock Text="{Binding QuantityNetText}" Classes="muted"/></StackPanel><Border x:Name="CompactCopilotCompositionBar" IsVisible="{Binding IsQuantityCompositionVisible}" Background="{DynamicResource GaugeTrackBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="0" AutomationProperties.Name="{Binding CompositionBarLabel}"><vm:CopilotCompositionBar Height="14" HorizontalAlignment="Stretch" IncludedRatio="{Binding IncludedCompositionRatio}" AdditionalRatio="{Binding AdditionalCompositionRatio}" TrackBrush="{DynamicResource GaugeTrackBrush}" IncludedBrush="{DynamicResource GaugeNormalBrush}" AdditionalBrush="{DynamicResource GaugeAttentionBrush}" AutomationProperties.Name="{Binding CompositionBarLabel}"/></Border><StackPanel IsVisible="{Binding IsQuantityCompositionVisible}" Spacing="2"><TextBlock Text="{Binding CompositionIncludedLabel}" TextWrapping="Wrap"/><TextBlock Text="{Binding CompositionAdditionalLabel}" Classes="muted" TextWrapping="Wrap"/></StackPanel><TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding ResetText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding FreshnessText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="4" Padding="18,8,18,16"><Button x:Name="CompactOpenFullButton" Content="{Binding CopyText.OpenFullWindow}" Click="OpenFullClick" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding CopyText.OpenFullWindow}"/></Border>
  </Grid>
</Window>
