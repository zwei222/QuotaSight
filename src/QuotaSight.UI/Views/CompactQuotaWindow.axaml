<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QuotaSight.UI" xmlns:ui="using:QuotaSight.UI.Controls" x:Class="QuotaSight.UI.CompactQuotaWindow" x:DataType="vm:MainViewModel" Icon="avares://QuotaSight.UI/Assets/quotasight.ico" Title="QuotaSight" Width="410" MinWidth="380" MaxWidth="430" Height="620" MaxHeight="700" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="Border.tokscale"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/></Style>
    <Style Selector="TextBlock.row-label"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/><Setter Property="FontWeight" Value="Normal"/></Style>
    <Style Selector="TextBlock.row-label.row-emph"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.quota-value.normal"><Setter Property="Foreground" Value="{DynamicResource GaugeNormalBrush}"/></Style>
    <Style Selector="TextBlock.quota-value.attention"><Setter Property="Foreground" Value="{DynamicResource GaugeAttentionBrush}"/></Style>
    <Style Selector="TextBlock.quota-value.danger"><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="TextBlock.quota-value.muted"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="TextBlock.tile-warning"><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/><Setter Property="Background" Value="{DynamicResource WarningBrush}"/><Setter Property="Padding" Value="6,1"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="Button.icon-action"><Setter Property="Width" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.icon-action PathIcon"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style Selector="Button.icon-action:pointerover"><Setter Property="Background" Value="{DynamicResource BannerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.icon-action:pressed"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.icon-action:pressed PathIcon"><Setter Property="Foreground" Value="{DynamicResource ContentBackgroundBrush}"/></Style>
    <Style Selector="Button.icon-action:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Button.icon-action:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource ContentBackgroundBrush}">
    <Border Grid.Row="0" Padding="18,16,18,8"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding CopyText.CompactTitle}" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="CompactCollectedLabel" Text="{Binding QuotaCollectedText}" Classes="muted" FontSize="12" Margin="0,3,0,0" IsVisible="{Binding IsQuotaCollectedKnown}"/></StackPanel><Button x:Name="CompactRefreshButton" Classes="icon-action" Grid.Column="1" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" ToolTip.Tip="{Binding CopyText.Refresh}" AutomationProperties.Name="{Binding CopyText.Refresh}"><PathIcon Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,15.31 15.31,18 12,18C9.24,18 6.95,16.13 6.25,13.6L4.31,14.15C5.25,17.5 8.33,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4Z"/></Button></Grid></Border>
    <Border Grid.Row="1" Margin="18,4,18,8" Padding="10" Background="{DynamicResource BannerBrush}" CornerRadius="9" IsVisible="False" AutomationProperties.Name="{Binding TokScaleStateText}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><ProgressBar x:Name="CompactRefreshProgress" IsIndeterminate="True" Width="72" VerticalAlignment="Center" AutomationProperties.Name="{Binding TokScaleStateText}"/><TextBlock Text="{Binding TokScaleStateText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
    <Border x:Name="CompactNotificationBanner" Grid.Row="2" Margin="18,0,18,8" Padding="10" Background="{DynamicResource WarningBrush}" CornerRadius="9" IsVisible="{Binding IsNotificationVisible}" AutomationProperties.Name="{Binding NotificationBannerText}"><TextBlock Text="{Binding NotificationBannerText}" Foreground="{DynamicResource WarningForegroundBrush}" TextWrapping="Wrap"/></Border>
    <ScrollViewer Grid.Row="3" Margin="18,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <StackPanel x:Name="CompactQuotaContracts" Spacing="8" IsVisible="{Binding IsQuotaSurfaceVisible}"><TextBlock Text="{Binding QuotaReadStatusText}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding IsQuotaStatusVisible}"/><ItemsControl ItemsSource="{Binding QuotaCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuotaProviderCard"><Border Classes="tokscale compact-tile" Height="118" MinHeight="118" MaxHeight="118"><Grid RowDefinitions="20,8,64"><Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" Height="20"><TextBlock Text="{Binding ProviderText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding ProviderText}"/><TextBlock Grid.Column="1" Text="{Binding FreshnessText}" FontSize="11" Classes="muted" Classes.tile-warning="{Binding IsWarning}" TextTrimming="CharacterEllipsis" MaxWidth="110" TextAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding !IsUnavailable}"/></Grid><Grid Grid.Row="2" ColumnDefinitions="64,12,*" Height="64"><Grid Width="64" Height="64"><ui:QuotaRingControl OuterInset="2" StrokeThickness="4" RingGap="3" Segments="{Binding RingValues}" UnknownBrush="{DynamicResource TextMutedBrush}" TrackBrush="{DynamicResource GaugeTrackBrush}" ValueBrush="{DynamicResource GaugeNormalBrush}" AttentionBrush="{DynamicResource GaugeAttentionBrush}" DangerBrush="{DynamicResource GaugeDangerBrush}" IsVisible="{Binding !IsUnavailable}"/><Ellipse Width="64" Height="64" Stroke="{DynamicResource GaugeNormalBrush}" StrokeThickness="4" Opacity="0.35" IsVisible="{Binding IsUnlimitedOnly}"/><Ellipse Width="64" Height="64" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="4" StrokeDashArray="0.75,1" StrokeLineCap="Flat" Opacity="0.6" IsVisible="{Binding IsUnavailable}"/></Grid><ItemsControl Grid.Column="2" ItemsSource="{Binding Windows}" VerticalAlignment="Center" IsVisible="{Binding !IsUnavailable}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuotaCardWindow"><Grid Height="20" ColumnDefinitions="72,52,*"><TextBlock Text="{Binding WindowText}" Classes="row-label" Classes.row-emph="{Binding IsEmphasized}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding RemainingText}" Classes="quota-value compact-value" Classes.normal="{Binding IsNormal}" Classes.attention="{Binding IsAttention}" Classes.danger="{Binding IsDanger}" Classes.muted="{Binding IsMuted}" FontSize="{Binding CompactValueFontSize}" FontWeight="Bold" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Margin="8,0,0,0" Text="{Binding ResetText}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding ResetText}" IsVisible="{Binding IsResetVisible}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Grid.Column="2" Text="{Binding UnavailableMessage}" FontSize="13" LineHeight="18" MaxHeight="36" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding IsUnavailable}"/></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <Border x:Name="CompactQuotaEmptyState" Classes="tokscale" IsVisible="{Binding IsQuotaSelectionEmpty}"><StackPanel Spacing="6"><TextBlock Text="{Binding CopyText.QuotaEmptyTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding CopyText.QuotaEmptySelection}" Classes="muted" FontSize="13" TextWrapping="Wrap"/><Button x:Name="CompactEmptyAddButton" Content="{Binding CopyText.QuotaCompactEmptyAdd}" Click="OpenFullAndManageClick" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="{Binding CopyText.QuotaCompactEmptyAdd}"/></StackPanel></Border>
        <Border x:Name="CompactTokScaleEmptyState" Classes="tokscale" IsVisible="False" AutomationProperties.Name="{Binding TokScaleEmptyTitleText}"><StackPanel Spacing="6"><TextBlock x:Name="CompactTokScaleEmptyTitle" Text="{Binding TokScaleEmptyTitleText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="{Binding TokScaleEmptyTitleText}"/><TextBlock x:Name="CompactTokScaleEmptyBody" Text="{Binding TokScaleEmptyBodyText}" Classes="muted" TextWrapping="Wrap" AutomationProperties.Name="{Binding TokScaleEmptyBodyText}"/></StackPanel></Border>
        <TextBlock x:Name="CompactTokScaleStatus" Classes="muted" Text="{Binding TokScaleStateText}" IsVisible="False" Margin="2,4" TextWrapping="Wrap" AutomationProperties.Name="{Binding TokScaleStateText}"/>
        <ItemsControl x:Name="CompactTokScaleCards" ItemsSource="{Binding TokScaleCards}" IsVisible="False" AutomationProperties.Name="{Binding TokScaleTitleText}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TokScaleUsageCard">
              <Border Classes="tokscale" Margin="0,0,0,7">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="None" AutomationProperties.Name="{Binding DisplayName}"/>
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding SummaryText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding SummaryText}"/>
                  <TextBlock Classes="muted" FontSize="10" Text="{Binding MultiProviderText}" IsVisible="{Binding IsMultiProvider}" TextWrapping="Wrap" AutomationProperties.Name="{Binding MultiProviderText}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="4" Padding="18,8,18,16"><Button x:Name="CompactOpenFullButton" Content="{Binding CopyText.OpenFullWindow}" Click="OpenFullClick" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding CopyText.OpenFullWindow}"/></Border>
  </Grid>
</Window>
