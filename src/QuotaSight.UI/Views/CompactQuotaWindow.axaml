<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QuotaSight.UI" x:Class="QuotaSight.UI.CompactQuotaWindow" x:DataType="vm:MainViewModel" Title="QuotaSight" Width="410" MinWidth="380" MaxWidth="430" Height="620" MaxHeight="700" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="Border.compact-card"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style Selector="ProgressBar"><Setter Property="MinHeight" Value="10"/><Setter Property="Background" Value="{DynamicResource GaugeTrackBrush}"/><Setter Property="Foreground" Value="{DynamicResource GaugeNormalBrush}"/></Style>
    <Style Selector="ProgressBar.Attention"><Setter Property="Foreground" Value="{DynamicResource GaugeAttentionBrush}"/></Style>
    <Style Selector="ProgressBar.Danger"><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="ProgressBar.OverLimit"><Setter Property="Foreground" Value="{DynamicResource GaugeOverBrush}"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,2"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource ContentBackgroundBrush}">
    <Border Grid.Row="0" Padding="18,16,18,8"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding CopyText.CompactTitle}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding CopyText.CompactSubtitle}" Classes="muted" Margin="0,3,0,0"/></StackPanel><Button x:Name="CompactRefreshButton" Grid.Column="1" Content="{Binding CopyText.Refresh}" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" AutomationProperties.Name="{Binding CopyText.Refresh}"/></Grid></Border>
    <Border Grid.Row="1" Margin="18,4,18,8" Padding="10" Background="{DynamicResource BannerBrush}" CornerRadius="9" IsVisible="{Binding IsQuotaDataBusy}" AutomationProperties.Name="{Binding QuotaStatusText}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><ProgressBar x:Name="CompactRefreshProgress" IsIndeterminate="True" Width="72" VerticalAlignment="Center" AutomationProperties.Name="{Binding QuotaStatusText}"/><TextBlock Text="{Binding QuotaStatusText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
    <Border x:Name="CompactNotificationBanner" Grid.Row="2" Margin="18,0,18,8" Padding="10" Background="{DynamicResource WarningBrush}" CornerRadius="9" IsVisible="{Binding IsNotificationVisible}" AutomationProperties.Name="{Binding NotificationBannerText}"><TextBlock Text="{Binding NotificationBannerText}" Foreground="{DynamicResource WarningForegroundBrush}" TextWrapping="Wrap"/></Border>
    <ScrollViewer Grid.Row="3" Margin="18,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border x:Name="CompactEmptyState" Classes="compact-card" IsVisible="{Binding HasEmptyState}" AutomationProperties.Name="{Binding EmptyStateText}"><StackPanel Spacing="6"><TextBlock x:Name="CompactEmptyStateText" Text="{Binding EmptyStateText}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CompactEmptyStateDescription" Text="{Binding EmptyStateDescription}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
        <ItemsControl x:Name="CompactProviderCards" ItemsSource="{Binding Cards}" IsVisible="{Binding HasCards}" AutomationProperties.Name="{Binding CopyText.CompactProviders}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ProviderCardViewModel"><Border Classes="compact-card" AutomationProperties.Name="{Binding AccessibleLabel}"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Account}" Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/></Grid><ItemsControl ItemsSource="{Binding Windows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuotaRowViewModel"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding WindowName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SourceBadge}" Classes="muted" FontSize="10"/></Grid><ProgressBar Value="{Binding VisualPercent}" Maximum="100" Classes.Attention="{Binding IsAttention}" Classes.Danger="{Binding IsDanger}" Classes.OverLimit="{Binding IsOverLimit}" AutomationProperties.Name="{Binding ProgressLabel}"/><TextBlock Text="{Binding PercentText}" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding ResetText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding FreshnessText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="4" Padding="18,8,18,16"><Button x:Name="CompactOpenFullButton" Content="{Binding CopyText.OpenFullWindow}" Click="OpenFullClick" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding CopyText.OpenFullWindow}"/></Border>
  </Grid>
</Window>
