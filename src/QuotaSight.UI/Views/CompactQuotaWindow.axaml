<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QuotaSight.UI" x:Class="QuotaSight.UI.CompactQuotaWindow" x:DataType="vm:MainViewModel" Icon="avares://QuotaSight.UI/Assets/quotasight.ico" Title="QuotaSight" Width="410" MinWidth="380" MaxWidth="430" Height="620" MaxHeight="700" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="TextBlock.Stale"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="TextBlock.ResetPending"><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.compact-tile"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="8,7,10,8"/><Setter Property="MinHeight" Value="112"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
    <Style Selector="Border.compact-tile.mono"/><Style Selector="Border.mono.small"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="CornerRadius" Value="6"/></Style>
    <Style Selector="Border.pill.small"><Setter Property="Padding" Value="4,1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="{DynamicResource BannerBrush}"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
    <Style Selector="Border.pill.small TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style Selector="Border.pill.small.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/></Style>
    <Style Selector="Border.pill.small.bad TextBlock"><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="Border.pill.small.over TextBlock"><Setter Property="Foreground" Value="{DynamicResource GaugeOverBrush}"/></Style>
    <Style Selector="Border.pill.small.neutral TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></Style>
    <Style Selector="Border.compact-card"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style Selector="ProgressBar"><Setter Property="MinHeight" Value="10"/><Setter Property="Background" Value="{DynamicResource GaugeTrackBrush}"/><Setter Property="Foreground" Value="{DynamicResource GaugeNormalBrush}"/></Style>
    <Style Selector="ProgressBar.Attention"><Setter Property="Foreground" Value="{DynamicResource GaugeAttentionBrush}"/></Style>
    <Style Selector="ProgressBar.Danger"><Setter Property="Foreground" Value="{DynamicResource GaugeDangerBrush}"/></Style>
    <Style Selector="ProgressBar.OverLimit"><Setter Property="Foreground" Value="{DynamicResource GaugeOverBrush}"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="Button.icon-action"><Setter Property="Width" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.icon-action PathIcon"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style Selector="Button.icon-action:pointerover"><Setter Property="Background" Value="{DynamicResource BannerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.icon-action:pressed"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Button.icon-action:pressed PathIcon"><Setter Property="Foreground" Value="{DynamicResource ContentBackgroundBrush}"/></Style>
    <Style Selector="Button.icon-action:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Button.icon-action:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource ContentBackgroundBrush}">
    <Border Grid.Row="0" Padding="18,16,18,8"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding CopyText.CompactTitle}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding CopyText.CompactSubtitle}" Classes="muted" Margin="0,3,0,0"/></StackPanel><Button x:Name="CompactRefreshButton" Classes="icon-action" Grid.Column="1" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" ToolTip.Tip="{Binding CopyText.Refresh}" AutomationProperties.Name="{Binding CopyText.Refresh}"><PathIcon Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,15.31 15.31,18 12,18C9.24,18 6.95,16.13 6.25,13.6L4.31,14.15C5.25,17.5 8.33,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4Z"/></Button></Grid></Border>
    <Border Grid.Row="1" Margin="18,4,18,8" Padding="10" Background="{DynamicResource BannerBrush}" CornerRadius="9" IsVisible="{Binding IsQuotaDataBusy}" AutomationProperties.Name="{Binding QuotaStatusText}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><ProgressBar x:Name="CompactRefreshProgress" IsIndeterminate="True" Width="72" VerticalAlignment="Center" AutomationProperties.Name="{Binding QuotaStatusText}"/><TextBlock Text="{Binding QuotaStatusText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
    <Border x:Name="CompactNotificationBanner" Grid.Row="2" Margin="18,0,18,8" Padding="10" Background="{DynamicResource WarningBrush}" CornerRadius="9" IsVisible="{Binding IsNotificationVisible}" AutomationProperties.Name="{Binding NotificationBannerText}"><TextBlock Text="{Binding NotificationBannerText}" Foreground="{DynamicResource WarningForegroundBrush}" TextWrapping="Wrap"/></Border>
    <ScrollViewer Grid.Row="3" Margin="18,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border x:Name="CompactEmptyState" Classes="compact-card" IsVisible="{Binding HasEmptyState}" AutomationProperties.Name="{Binding EmptyStateText}"><StackPanel Spacing="6"><TextBlock x:Name="CompactEmptyStateText" Text="{Binding EmptyStateText}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CompactEmptyStateDescription" Text="{Binding EmptyStateDescription}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
        <ItemsControl x:Name="CompactProviderCards" ItemsSource="{Binding Cards}" IsVisible="{Binding HasCards}" AutomationProperties.Name="{Binding CopyText.CompactProviders}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ProviderCardViewModel"><Border Classes="compact-tile" Classes.quantity="{Binding IsCopilotReferenceVisible}" AutomationProperties.Name="{Binding AccessibleLabel}"><Grid RowDefinitions="Auto,Auto,Auto"><Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6"><StackPanel Orientation="Horizontal" Spacing="6"><Border Classes="mono small" VerticalAlignment="Center"><TextBlock Text="{Binding ProviderMonogram}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding HeaderFreshnessText}" Classes="muted" FontSize="9" VerticalAlignment="Center" AutomationProperties.Name="{Binding HeaderFreshnessText}"/></Grid><Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10"><Grid Grid.Column="0" Width="72" Height="72" VerticalAlignment="Top" IsVisible="{Binding HasRingSegments}"><vm:QuotaRingControl x:Name="CompactQuotaRing" Segments="{Binding RingSegments}" TrackBrush="{DynamicResource GaugeTrackBrush}" NormalBrush="{DynamicResource GaugeNormalBrush}" AttentionBrush="{DynamicResource GaugeAttentionBrush}" DangerBrush="{DynamicResource GaugeDangerBrush}" OverLimitBrush="{DynamicResource GaugeOverBrush}" StaleBrush="{DynamicResource TextMutedBrush}"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasKnownRemainingCenter}"><TextBlock Text="{Binding RemainingCenterText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" AutomationProperties.Name="{Binding RemainingCenterText}"/><TextBlock Text="{Binding RemainingCenterPeriodText}" Classes="muted" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0" AutomationProperties.Name="{Binding RemainingCenterPeriodText}"/></StackPanel></Grid><Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="6" VerticalAlignment="Top"><ItemsControl Grid.Column="0" ItemsSource="{Binding WindowsLeft}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuotaRowViewModel"><StackPanel Spacing="2" Margin="0,0,0,4" ToolTip.Tip="{Binding ProgressLabel}" IsVisible="{Binding IsFactVisible}"><StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsPercentVisible}"><TextBlock Text="{Binding WindowName}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" AutomationProperties.Name="{Binding WindowName}"/><TextBlock Text="{Binding FactValueText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" AutomationProperties.Name="{Binding ProgressLabel}"/></StackPanel><WrapPanel HorizontalAlignment="Left" IsVisible="{Binding IsPercentVisible}"><TextBlock Text="{Binding FactResetText}" Classes="muted" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="{Binding ProgressLabel}"/><Border Classes="pill small" Classes.warn="{Binding IsPillWarn}" Classes.bad="{Binding IsPillBad}" Classes.over="{Binding IsPillOver}" Classes.neutral="{Binding IsPillNeutral}" IsVisible="{Binding HasPill}"><TextBlock Text="{Binding PillText}" FontSize="8" FontWeight="SemiBold" AutomationProperties.Name="{Binding PillText}"/></Border></WrapPanel><StackPanel Spacing="1" IsVisible="{Binding IsQuantityVisible}"><TextBlock Text="{Binding QuantityGrossText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="{Binding ProgressLabel}"/><TextBlock Text="{Binding QuantityDiscountText}" Classes="muted" FontSize="9"/><TextBlock Text="{Binding QuantityNetText}" Classes="muted" FontSize="9"/><TextBlock Text="{Binding QuantityNoteText}" Classes="muted" FontSize="8" IsVisible="{Binding $parent[ItemsControl].((vm:ProviderCardViewModel)DataContext).IsRateNoteVisible}" AutomationProperties.Name="{Binding ProgressLabel}"/></StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl Grid.Column="1" ItemsSource="{Binding WindowsRight}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuotaRowViewModel"><StackPanel Spacing="2" Margin="0,0,0,4" ToolTip.Tip="{Binding ProgressLabel}" IsVisible="{Binding IsFactVisible}"><StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsPercentVisible}"><TextBlock Text="{Binding WindowName}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" AutomationProperties.Name="{Binding WindowName}"/><TextBlock Text="{Binding FactValueText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" AutomationProperties.Name="{Binding ProgressLabel}"/></StackPanel><WrapPanel HorizontalAlignment="Left" IsVisible="{Binding IsPercentVisible}"><TextBlock Text="{Binding FactResetText}" Classes="muted" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="{Binding ProgressLabel}"/><Border Classes="pill small" Classes.warn="{Binding IsPillWarn}" Classes.bad="{Binding IsPillBad}" Classes.over="{Binding IsPillOver}" Classes.neutral="{Binding IsPillNeutral}" IsVisible="{Binding HasPill}"><TextBlock Text="{Binding PillText}" FontSize="8" FontWeight="SemiBold" AutomationProperties.Name="{Binding PillText}"/></Border></WrapPanel><StackPanel Spacing="1" IsVisible="{Binding IsQuantityVisible}"><TextBlock Text="{Binding QuantityGrossText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="{Binding ProgressLabel}"/><TextBlock Text="{Binding QuantityDiscountText}" Classes="muted" FontSize="9"/><TextBlock Text="{Binding QuantityNetText}" Classes="muted" FontSize="9"/></StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Grid.ColumnSpan="2" Classes="chip" Padding="5,2" HorizontalAlignment="Left" IsVisible="{Binding IsCopilotReferenceVisible}" AutomationProperties.Name="{Binding CopilotReferenceBadge}"><TextBlock Text="{Binding CopilotReferenceBadge}" FontSize="8"/></Border><TextBlock Grid.ColumnSpan="2" Text="{Binding CopilotReferenceText}" Classes="muted" FontSize="8" TextWrapping="Wrap" IsVisible="{Binding IsCopilotReferenceVisible}" AutomationProperties.Name="{Binding CopilotReferenceText}"/></Grid><TextBlock Grid.Row="2" Text="{Binding CopilotReferenceDisclaimer}" Classes="muted" FontSize="8" TextWrapping="Wrap" IsVisible="{Binding IsCopilotReferenceVisible}" Margin="0,4,0,0" AutomationProperties.Name="{Binding CopilotReferenceDisclaimer}"/></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="4" Padding="18,8,18,16"><Button x:Name="CompactOpenFullButton" Content="{Binding CopyText.OpenFullWindow}" Click="OpenFullClick" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding CopyText.OpenFullWindow}"/></Border>
  </Grid>
</Window>
