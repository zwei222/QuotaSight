<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fluent="using:Avalonia.Themes.Fluent" x:Class="QuotaSight.UI.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#F4F6F3"/>
          <SolidColorBrush x:Key="SidebarBrush" Color="#EEF1ED"/>
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="BannerBrush" Color="#E5F1EC"/>
          <SolidColorBrush x:Key="BorderBrush" Color="#DCE3DE"/>
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17211D"/>
          <SolidColorBrush x:Key="TextMutedBrush" Color="#64716B"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#167C68"/>
          <SolidColorBrush x:Key="WarningBrush" Color="#F4E5D1"/>
          <SolidColorBrush x:Key="WarningForegroundBrush" Color="#704516"/>
          <SolidColorBrush x:Key="StatusTextForegroundBrush" Color="#17211D"/>
          <SolidColorBrush x:Key="DisabledBrush" Color="#89938D"/>
          <SolidColorBrush x:Key="GaugeTrackBrush" Color="#E1E7E3"/>
          <SolidColorBrush x:Key="GaugeNormalBrush" Color="#167C68"/>
          <SolidColorBrush x:Key="GaugeAttentionBrush" Color="#9A6500"/>
          <SolidColorBrush x:Key="GaugeDangerBrush" Color="#B33B36"/>
          <SolidColorBrush x:Key="GaugeOverBrush" Color="#7952A3"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#101715"/>
          <SolidColorBrush x:Key="SidebarBrush" Color="#151D1A"/>
          <SolidColorBrush x:Key="CardBrush" Color="#1B2420"/>
          <SolidColorBrush x:Key="InputBrush" Color="#161F1B"/>
          <SolidColorBrush x:Key="BannerBrush" Color="#202F29"/>
          <SolidColorBrush x:Key="BorderBrush" Color="#34443C"/>
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F2"/>
          <SolidColorBrush x:Key="TextMutedBrush" Color="#B5C2BA"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#73D6B1"/>
          <SolidColorBrush x:Key="WarningBrush" Color="#533B25"/>
          <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FFE1B6"/>
          <SolidColorBrush x:Key="StatusTextForegroundBrush" Color="#F1F5F2"/>
          <SolidColorBrush x:Key="DisabledBrush" Color="#89958E"/>
          <SolidColorBrush x:Key="GaugeTrackBrush" Color="#394A41"/>
          <SolidColorBrush x:Key="GaugeNormalBrush" Color="#73D6B1"/>
          <SolidColorBrush x:Key="GaugeAttentionBrush" Color="#F0C66A"/>
          <SolidColorBrush x:Key="GaugeDangerBrush" Color="#FF918A"/>
          <SolidColorBrush x:Key="GaugeOverBrush" Color="#D0A4F2"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <fluent:FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BannerBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="TextBox:disabled, ComboBox:disabled, NumericUpDown:disabled, Button:disabled">
      <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </Application.Styles>
</Application>
