<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fluent="using:Avalonia.Themes.Fluent" x:Class="QuotaSight.UI.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#F8FAFC"/>
          <SolidColorBrush x:Key="SidebarBrush" Color="#F1F3F6"/>
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="BannerBrush" Color="#E8EEFF"/>
          <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE8"/>
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033"/>
          <SolidColorBrush x:Key="TextMutedBrush" Color="#5E6A7E"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#405DE6"/>
          <SolidColorBrush x:Key="WarningBrush" Color="#8B4D08"/>
          <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="DisabledBrush" Color="#8993A3"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#0F131B"/>
          <SolidColorBrush x:Key="SidebarBrush" Color="#151A24"/>
          <SolidColorBrush x:Key="CardBrush" Color="#202735"/>
          <SolidColorBrush x:Key="InputBrush" Color="#171D29"/>
          <SolidColorBrush x:Key="BannerBrush" Color="#242B48"/>
          <SolidColorBrush x:Key="BorderBrush" Color="#3A465A"/>
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FB"/>
          <SolidColorBrush x:Key="TextMutedBrush" Color="#C1CAD8"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#AAB8FF"/>
          <SolidColorBrush x:Key="WarningBrush" Color="#FFC078"/>
          <SolidColorBrush x:Key="WarningForegroundBrush" Color="#1F160B"/>
          <SolidColorBrush x:Key="DisabledBrush" Color="#7D8798"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <fluent:FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="TextBox:disabled, ComboBox:disabled, NumericUpDown:disabled, Button:disabled">
      <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </Application.Styles>
</Application>
