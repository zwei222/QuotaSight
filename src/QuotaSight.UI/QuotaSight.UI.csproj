<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <OutputType Condition="'$(OS)' != 'Windows_NT'">Exe</OutputType>
    <PublishAot>true</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationIcon>Assets/quotasight.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Release archives ship no debug symbols. Native AOT derives its own symbol emission from
         DebugType, so turning it off there stops both the managed .pdb and the native .dbg/.pdb. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <StripSymbols>true</StripSymbols>
    <!-- Project references still build their own portable .pdb files; do not copy them into the
         published folder either. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <!-- The test projects reference this project. Keeping the Windows App SDK build assets private
         stops its targets (the self-contained check, the generated auto-initializer source and the
         payload copy) from running inside projects that only use this project's types and never
         start the app. Compile and runtime assets still flow, so the managed projections stay
         available to them. -->
    <WindowsAppSdkPrivateAssets>build;buildtransitive;buildmultitargeting;contentfiles;analyzers</WindowsAppSdkPrivateAssets>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <!-- Only the toast notification API is used (Microsoft.Windows.AppNotifications lives in
         Foundation). Referencing the Microsoft.WindowsAppSDK metapackage also pulled in
         WinUI, onnxruntime and DirectML, inflating the Windows ZIP with ~300 unused files. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.7.0" PrivateAssets="$(WindowsAppSdkPrivateAssets)" />
    <!-- Foundation 2.7.0 depends on InteractiveExperiences as the range [2.7.0, 3.0.0), and 2.7.0 is
         published, so plain restore needs no NU1603 workaround any more. The explicit reference
         stays because the range would otherwise float onto whatever 2.7.x a later restore finds,
         silently changing the bundled framework payload without a repository change. Pinning the
         version Foundation resolves to keeps one reviewed version in the Windows ZIP. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.7.0" PrivateAssets="$(WindowsAppSdkPrivateAssets)" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../QuotaSight.Application/QuotaSight.Application.csproj" /><ProjectReference Include="../QuotaSight.Infrastructure/QuotaSight.Infrastructure.csproj" /></ItemGroup>
  <ItemGroup><AvaloniaResource Include="Assets/quotasight-icon.svg" /><AvaloniaResource Include="Assets/quotasight-*.png" /><AvaloniaResource Include="Assets/quotasight.ico" /></ItemGroup>
</Project>
